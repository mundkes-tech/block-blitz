{
  "name": "block-blitz",
  "version": "1.0.0",
  "private": true,
  "description": "A full-stack browser-based block puzzle game",
  "scripts": {
    "dev:client": "npm --prefix client run dev",
    "dev:server": "tsx watch server/src/index.ts",
    "build:client": "npm --prefix client run build",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm run build:server",
    "start": "node server/dist/index.js",
    "test:client": "node --import tsx --test client/src/game/gameLogic.test.ts",
    "test:server": "node --import tsx --test server/test/gameSessions.test.ts server/test/auth.test.ts",
    "test": "npm run test:client && npm run test:server"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
